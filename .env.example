# ==========================================================================
# MOYO PLATFORM - ENVIRONMENT TEMPLATE
# ==========================================================================
# Copy to `.env.local` for development. NEVER commit the real file.
#   cp .env.example .env.local
#
# In production these MUST come from your hosting platform's secret manager
# (Vercel Environment Variables, AWS Secrets Manager, Docker secrets, ...).
# ==========================================================================

# --- Database --------------------------------------------------------------
# SQLite for local development. For production switch the Prisma datasource
# provider to postgresql and use a managed connection string.
# NOTE: the password below is a LOCAL placeholder only. Never use it in prod.
DATABASE_URL="file:./dev.db"

# --- Sessions --------------------------------------------------------------
# Generates the HMAC key used to sign session/CSRF material.
# Generate with:  openssl rand -base64 48
# REQUIRED IN PRODUCTION. The app refuses to boot without it.
SESSION_SECRET=""

# --- Application URLs ------------------------------------------------------
# Used for CSRF origin validation and absolute links in emails.
APP_URL="http://localhost:3000"

# --- Payment gateway -------------------------------------------------------
# Leave EMPTY in development. When empty, the payment provider is treated as
# NOT CONFIGURED and the checkout endpoint returns 503 rather than pretending
# to process money. Never commit real credentials.
PAYMENT_PROVIDER=""
PAYMENT_WEBHOOK_SECRET=""

# --- Rate limiting ---------------------------------------------------------
# Optional shared store identifier for multi-instance deployments.
RATE_LIMIT_STORE="memory"

# --- Uploads ---------------------------------------------------------------
# Directory OUTSIDE the Next.js public/ web root. Must not be web-served.
UPLOAD_DIR="./storage/uploads"
# Max upload size in megabytes.
MAX_UPLOAD_MB="5"